# thawd 7.3 session sandbox (seccomp-bpf)
# generated by `thawd policy` from the filter the binary installs
#
# installed: in every session process, after the session is set up
#            and before its first plan is read
# no_new_privs: 1
# arch: x86_64 only, anything else -> kill-process
# x32 syscall numbers -> kill-process
# not listed -> trap (the session logs the call and exits)

[allow]
  0  read
  1  write
 20  writev
  7  poll
271  ppoll
228  clock_gettime
230  clock_nanosleep
 35  nanosleep
318  getrandom
 15  rt_sigreturn
219  restart_syscall
 60  exit
231  exit_group

